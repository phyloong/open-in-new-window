{
  "name": "new-window-here",
  "displayName": "New Window Here",
  "description": "Open files, folders and remote contexts in a new VS Code window.",
  "version": "0.1.1",
  "publisher": "amapleaf",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/phyloong/open-in-new-window.git"
  },
  "icon": "resources/icon.png",
  "engines": {
    "vscode": "^1.104.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "window",
    "workspace",
    "folder",
    "remote",
    "wsl",
    "ssh"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "openInNewWindow.open",
        "title": "Open in New Window"
      }
    ],
    "configuration": {
      "title": "Open in New Window",
      "properties": {
        "openInNewWindow.allowMultiSelection": {
          "type": "boolean",
          "default": false,
          "description": "Allow one invocation to open more than one target: show the Explorer item for a multi-selection and let the Command Palette picker accept several targets, opening one new window per selected resource."
        }
      }
    },
    "menus": {
      "explorer/context": [
        {
          "command": "openInNewWindow.open",
          "when": "(resourceScheme == file || resourceScheme == 'vscode-remote') && (!listMultiSelection || config.openInNewWindow.allowMultiSelection)",
          "group": "navigation@10"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "npm run clean && tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test",
    "clean": "node -e \"require('node:fs').rmSync('out', { recursive: true, force: true })\""
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.104.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all2": "^9.0.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
